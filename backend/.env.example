# Servidor
PORT=3000
NODE_ENV=development

# JWT (cambiar en producción por una clave segura de 32+ caracteres)
JWT_SECRET=clave-super-secreta-de-al-menos-32-caracteres
JWT_EXPIRES_IN=7d

# Base de datos
# Desarrollo local (SQLite)
DATABASE_URL="file:./dev.db"

# Producción (PostgreSQL - descomentar cuando migres)
# DATABASE_URL="postgresql://usuario:password@host:5432/turnos?schema=public"